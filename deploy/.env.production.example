# Public hostname only, without a path. Use a domain you control so Caddy can issue HTTPS.
SITE_ADDRESS=preview.example.com
ACME_EMAIL=owner@example.com

# Tag the deployed container with the exact Git commit.
MAZANN_IMAGE_TAG=replace-with-git-commit

MAZANN_PLANNER_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=replace-with-a-new-restricted-key

MCP_ISLAMIC_CONTENT_URL=https://mcp.islamiccontent.org/mcp
MCP_TIMEOUT_MS=12000
MAZANN_PLANNER_TIMEOUT_MS=30000
MAZANN_CACHE_WRITE=true
