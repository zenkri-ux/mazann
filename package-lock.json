{
  "name": "@mazann/monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@mazann/monorepo",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "packages/connectors/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@mazann/api",
      "version": "0.1.0",
      "dependencies": {
        "@mazann/domain": "*",
        "@mazann/islamic-content-connector": "*",
        "@mazann/openai-planner": "*"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "apps/web": {
      "name": "@mazann/web",
      "version": "0.1.0"
    },
    "node_modules/@mazann/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@mazann/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@mazann/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@mazann/islamic-content-connector": {
      "resolved": "packages/connectors/islamic-content",
      "link": true
    },
    "node_modules/@mazann/openai-planner": {
      "resolved": "packages/connectors/openai-planner",
      "link": true
    },
    "node_modules/@mazann/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/connectors/islamic-content": {
      "name": "@mazann/islamic-content-connector",
      "version": "0.1.0"
    },
    "packages/connectors/openai-planner": {
      "name": "@mazann/openai-planner",
      "version": "0.1.0"
    },
    "packages/contracts": {
      "name": "@mazann/contracts",
      "version": "0.1.0"
    },
    "packages/domain": {
      "name": "@mazann/domain",
      "version": "0.1.0"
    }
  }
}
