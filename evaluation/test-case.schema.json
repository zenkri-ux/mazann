{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazann.local/schemas/test-case.schema.json",
  "title": "Mazann reviewer test catalogue",
  "type": "object",
  "required": ["schema_version", "product", "status_values", "severity_values", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "product": { "const": "Mazann" },
    "status_values": {
      "type": "array",
      "items": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
      "uniqueItems": true
    },
    "severity_values": {
      "type": "array",
      "items": { "enum": ["blocker", "critical", "major", "minor"] },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "testCase": {
      "type": "object",
      "required": [
        "id",
        "suite",
        "priority",
        "reviewer_roles",
        "title",
        "objective",
        "task",
        "expected",
        "critical_failures",
        "metrics"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$" },
        "suite": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "reviewer_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["CR", "UR", "OB", "TEAM"] },
          "uniqueItems": true
        },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/nonEmptyStringArray" },
        "critical_failures": { "$ref": "#/$defs/nonEmptyStringArray" },
        "metrics": { "$ref": "#/$defs/nonEmptyStringArray" },
        "preconditions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "fixtures": { "$ref": "#/$defs/nonEmptyStringArray" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
