{
  "name": "@mazann/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "مَظَانّ — evidence-grounded research assistant for Friday preachers",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm --workspace @mazann/api run dev",
    "start": "npm --workspace @mazann/api run start",
    "test": "node --test",
    "eval:planner": "node --env-file-if-exists=.env scripts/evaluate-planner.mjs",
    "eval:quran": "node scripts/evaluate-quran-retrieval.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo-cache.mjs",
    "index:quran": "node --env-file-if-exists=.env scripts/build-quran-search-index.mjs",
    "manifest:sources": "node --env-file-if-exists=.env scripts/build-source-manifest.mjs",
    "docker:build": "docker build -t mazann:local .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
