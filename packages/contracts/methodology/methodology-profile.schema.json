{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazann.local/schemas/methodology-profile.schema.json",
  "title": "Mazann methodology profile",
  "type": "object",
  "required": [
    "methodology_id",
    "version",
    "status",
    "name_ar",
    "scope",
    "authority_references",
    "required_inputs",
    "stages",
    "human_review_gates",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "methodology_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "approved", "deprecated", "future"] },
    "name_ar": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "authority_references": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "required_inputs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "name_ar", "purpose", "required_outputs"],
        "properties": {
          "stage_id": { "type": "string" },
          "name_ar": { "type": "string" },
          "purpose": { "type": "string" },
          "required_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "human_review_gates": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
