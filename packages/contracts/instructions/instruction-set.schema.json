{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazann.local/schemas/instruction-set.schema.json",
  "title": "Mazann institutional instruction set",
  "type": "object",
  "required": [
    "instruction_id",
    "version",
    "issuer",
    "source",
    "jurisdiction",
    "applies_to",
    "issued_at",
    "instruction_type",
    "binding_level",
    "adaptation_policy",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "instruction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "issuer": {
      "type": "object",
      "required": ["name", "type"],
      "properties": { "name": { "type": "string" }, "type": { "enum": ["government", "institution", "test_fixture"] } }
    },
    "source": {
      "type": "object",
      "required": ["url", "source_type", "retrieved_at"],
      "properties": {
        "url": { "type": "string" },
        "source_type": { "enum": ["primary_directive", "issuer_news", "official_portal", "test_fixture"] },
        "retrieved_at": { "type": "string", "format": "date" },
        "checksum": { "type": ["string", "null"] }
      }
    },
    "jurisdiction": { "type": "object" },
    "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "issued_at": { "type": "string", "format": "date" },
    "valid_from": { "type": ["string", "null"], "format": "date" },
    "valid_to": { "type": ["string", "null"], "format": "date" },
    "instruction_type": { "enum": ["required_topic", "official_text_supplied", "exact_text_required", "required_points", "prohibition", "guidance", "mixed"] },
    "required_topic": { "type": ["string", "null"] },
    "required_points": { "type": "array", "items": { "type": "object" } },
    "prohibited_points": { "type": "array", "items": { "type": "object" } },
    "binding_level": { "enum": ["mandatory", "guidance", "unknown"] },
    "adaptation_policy": { "enum": ["permitted", "restricted", "prohibited", "unknown"] },
    "verification": {
      "type": "object",
      "required": ["status", "scope_reviewed"],
      "properties": {
        "status": { "enum": ["draft", "verified", "expired", "superseded", "disputed", "test_fixture"] },
        "scope_reviewed": { "type": "boolean" },
        "verified_by": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date" }
      }
    }
  },
  "additionalProperties": true
}
