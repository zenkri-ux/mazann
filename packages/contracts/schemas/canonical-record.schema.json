{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazann.example/schemas/canonical-record.schema.json",
  "title": "Mazann canonical evidence record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "canonical_id",
    "source_family",
    "origin_platform",
    "reference",
    "access",
    "content_type",
    "language",
    "text",
    "citation_url",
    "checksum_sha256",
    "fetched_at",
    "publication_status",
    "metadata",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "canonical_id": { "type": "string", "minLength": 1 },
    "source_family": { "enum": ["quran", "hadith", "tafsir", "sirah", "library"] },
    "origin_platform": { "type": "string", "minLength": 1 },
    "reference": {
      "type": "object",
      "required": ["key", "work_title_ar", "locator_ar", "source_label_ar", "precision", "primary_locator_available", "verification_note_ar"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "work_title_ar": { "type": "string", "minLength": 1 },
        "locator_ar": { "type": "string", "minLength": 1 },
        "source_label_ar": { "type": "string", "minLength": 1 },
        "precision": { "enum": ["exact_unit", "collection_level", "provider_record_only"] },
        "primary_locator_available": { "type": "boolean" },
        "verification_note_ar": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["provider_name", "provider_record_id", "url"],
      "properties": {
        "provider_name": { "type": "string", "minLength": 1 },
        "provider_record_id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "authority_tier": { "type": "string" },
    "content_type": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "text": { "type": "string", "minLength": 1 },
    "citation_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "upstream_version": { "type": ["string", "null"] },
    "publication_status": {
      "enum": ["eligible_for_review", "blocked_until_upstream_version_is_recorded", "blocked_by_validation"]
    },
    "metadata": { "type": "object" },
    "validation": {
      "type": "object",
      "required": ["checks", "status"],
      "properties": {
        "checks": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "status": { "enum": ["valid", "blocked"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
