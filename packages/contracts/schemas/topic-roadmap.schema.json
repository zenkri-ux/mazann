{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazann.local/schemas/topic-roadmap.schema.json",
  "title": "Mazann topic roadmap",
  "type": "object",
  "required": [
    "roadmap_id",
    "methodology",
    "generation_mode",
    "brief",
    "policy_gate",
    "axes",
    "human_review"
  ],
  "properties": {
    "roadmap_id": { "type": "string", "pattern": "^roadmap_[a-f0-9]{16}$" },
    "methodology": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "friday_sermon_research" },
        "version": { "type": "string" }
      }
    },
    "generation_mode": { "enum": ["methodology_template", "model_assisted"] },
    "brief": {
      "type": "object",
      "required": ["topic", "target_audience", "format", "duration", "language"],
      "properties": {
        "topic": { "type": "string", "minLength": 8, "maxLength": 240 },
        "target_audience": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "language": { "const": "ar" }
      }
    },
    "policy_gate": {
      "type": "object",
      "required": ["official_instruction_state", "decision", "content_level"],
      "properties": {
        "official_instruction_state": { "enum": ["none_declared", "unverified", "verified"] },
        "decision": { "enum": ["proceed_with_visible_caveat", "proceed", "hold_for_verification"] },
        "content_level": { "enum": ["requires_classification", "a", "b", "c", "d"] }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["axis_id", "role", "title", "research_question", "purpose", "evidence_requirements", "time_minutes"],
        "properties": {
          "axis_id": { "type": "string" },
          "role": { "enum": ["foundation", "context", "application", "outcome"] },
          "title": { "type": "string", "minLength": 1 },
          "research_question": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["quran", "hadith", "tafsir", "sirah", "approved_research"] }
          },
          "time_minutes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "human_review": {
      "type": "object",
      "required": ["required", "checkpoint", "questions"],
      "properties": {
        "required": { "const": true },
        "checkpoint": { "const": "approve_or_edit_plan" },
        "questions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
